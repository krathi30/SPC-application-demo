# Copy to .env and fill in before running `docker compose up`.
# .env is git-ignored; never commit real values.

# Required. Generate one with: openssl rand -base64 32
DB_PASSWORD=

# Host port the app is served on.
HTTP_PORT=80

# Reverse proxies in front of the API: 1 = nginx only,
# 2 = nginx behind an AWS Application Load Balancer.
TRUST_PROXY_HOPS=1

# Set to true once the site is served over HTTPS only.
COOKIE_SECURE=false

# Public URL of the app, e.g. https://spc.example.com (optional).
APP_ORIGIN=

# SMTP (or run: cd backend && npm run setup-smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# Image tag for the built images (spc-backend / spc-frontend).
APP_TAG=fixed
